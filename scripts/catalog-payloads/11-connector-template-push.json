{
  "authentication": {
    "type": "BEARER_TOKEN",
    "token": {
      "type": "PLAIN",
      "content": "{{__TOKEN__}}"
    }
  },
  "interaction": {
    "mode": "PUSH",
    "subscribe": {
      "protocol": "HTTP",
      "urlTemplate": "{{__SUB_URL__}}",
      "method": "POST",
      "headers": { "Content-Type": "application/json" },
      "bodyTemplate": "{\"url\": \"{{__SYS_OWN_URL_DOCKER__}}{{__RUNTIME_INGRESS__}}\", \"event_type\": \"{{__EVENT_TYPE__}}\"}"
    },
    "unsubscribe": {
      "protocol": "HTTP",
      "urlTemplate": "{{__SUB_URL__}}/{{__RUNTIME_JSON_{.subscription.id}__}}",
      "method": "DELETE",
      "headers": {},
      "bodyTemplate": "{}"
    }
  },
  "parameters": [
    {
      "paramType": "STRING",
      "name": "SUB_URL",
      "title": "Subscription base URL",
      "required": true
    },
    {
      "paramType": "STRING",
      "name": "EVENT_TYPE",
      "title": "Event Type",
      "required": true
    },
    {
      "paramType": "STRING",
      "name": "TOKEN",
      "title": "Bearer Token",
      "required": true
    }
  ]
}
