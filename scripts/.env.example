# Copy this file to scripts/.env and fill in the real values.
# scripts/.env is gitignored — never commit it.

# ── Authority (DEV-DATASPACES / heimdall) ─────────────────────────────────────
AUTHORITY_SSH_USER=
AUTHORITY_SSH_PASS=
AUTHORITY_SSH_HOST=
AUTHORITY_PATH=/home/ging/eunomia-deployment/deployment/prod
AUTHORITY_SERVICE=heimdall
AUTHORITY_COMPOSE=docker-compose.heimdall.yaml

# ── Consumer (EUNOMIA-CONSUMER) ───────────────────────────────────────────────
CONSUMER_SSH_USER=
CONSUMER_SSH_PASS=
CONSUMER_SSH_HOST=
CONSUMER_PATH=/home/aegon/eunomia-deployment/deployment/prod
CONSUMER_SERVICE=consumer
CONSUMER_COMPOSE=docker-compose.consumer.yaml

# ── Provider (EUNOMIA-PROVIDER) ───────────────────────────────────────────────
PROVIDER_SSH_USER=
PROVIDER_SSH_PASS=
PROVIDER_SSH_HOST=
PROVIDER_PATH=/home/tftfuel/eunomia/eunomia-deployment/deployment/prod
PROVIDER_SERVICE=provider
PROVIDER_COMPOSE=docker-compose.provider.yaml

# ── Consumer-client-stack (same host as consumer) ────────────────────────────
CONSUMER_CLIENT_SSH_USER=
CONSUMER_CLIENT_SSH_PASS=
CONSUMER_CLIENT_SSH_HOST=
CONSUMER_CLIENT_PATH=/home/aegon/eunomia-ecostars-deployment/services/consumer-client-stack
CONSUMER_CLIENT_COMPOSE=docker-compose.nonifi.yaml
