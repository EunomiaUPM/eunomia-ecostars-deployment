# Copy to .env at the repo root and fill in what you use. .env is gitignored.
# Anything already exported in your shell wins over this file.
#
# Standalone needs none of this: every URL has a working default. The ESDS
# credentials are not here either, they live in services/provider-final-system/.env.

# ── Participant URLs (prod) ──────────────────────────────────────────────────
# How the CLI reaches each participant. Prod has no defaults.
AUTHORITY_URL=
PROVIDER_URL=
CONSUMER_URL=

# How the participants reach each other. Default: the URLs above, which is
# right in prod. Standalone uses http://host.docker.internal:<port>.
# DOCKER_AUTHORITY_URL=
# DOCKER_PROVIDER_URL=
# DOCKER_CONSUMER_URL=

# ── eunomia restart: SSH access to the prod servers ─────────────────────────
# Leave *_SSH_PASS empty to use SSH keys; setting it requires sshpass.
# *_COMPOSE and *_SERVICE default to the files and services in deployment/prod.

AUTHORITY_SSH_USER=
AUTHORITY_SSH_PASS=
AUTHORITY_SSH_HOST=
AUTHORITY_PATH=/home/ging/eunomia-deployment/deployment/prod
# AUTHORITY_COMPOSE=docker-compose.heimdall.yaml
# AUTHORITY_SERVICE=heimdall

PROVIDER_SSH_USER=
PROVIDER_SSH_PASS=
PROVIDER_SSH_HOST=
PROVIDER_PATH=/home/tftfuel/eunomia/eunomia-deployment/deployment/prod
# PROVIDER_COMPOSE=docker-compose.provider.yaml
# PROVIDER_SERVICE=provider

CONSUMER_SSH_USER=
CONSUMER_SSH_PASS=
CONSUMER_SSH_HOST=
CONSUMER_PATH=/home/aegon/eunomia-deployment/deployment/prod
# CONSUMER_COMPOSE=docker-compose.consumer.yaml
# CONSUMER_SERVICE=consumer

# Client stack, same host as the consumer
CONSUMER_CLIENT_SSH_USER=
CONSUMER_CLIENT_SSH_PASS=
CONSUMER_CLIENT_SSH_HOST=
CONSUMER_CLIENT_PATH=/home/aegon/eunomia-ecostars-deployment/services/consumer-client-stack
CONSUMER_CLIENT_COMPOSE=docker-compose.nonifi.yaml
